# === Backend Environment Configuration ===
# Copy this file to .env and fill in your values

# Server
NODE_ENV=development
PORT=3300
BACKEND_URL=http://localhost:3300
CLIENT_URL=http://localhost:5173

# === Database ===
# Choose ONE MongoDB connection string:

# Option 1: Local MongoDB (default for development)
MONGODB_URI=mongodb://localhost:27017/pollman

# Option 2: MongoDB Atlas (production)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/pollman?retryWrites=true&w=majority

# === JWT ===
# Generate with: openssl rand -hex 32
# Token expires in 1 day (24 hours)
JWT_SECRET=your_jwt_secret_change_this_in_production

# === Google OAuth ===
# Get credentials from: https://console.cloud.google.com
# Required scopes: profile, email
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
